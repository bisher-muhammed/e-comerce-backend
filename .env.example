# Copy to .env and fill in real values. Never commit .env.

# ── Server ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# Number of proxy hops to trust, or "true"/"false".
# Set this when running behind a load balancer or reverse proxy,
# otherwise rate limiting and req.ip see the proxy instead of the client.
TRUST_PROXY=false

# ── Auth ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me

# Domain scope for the auth cookies.
#
# Leave UNSET locally: the API and the storefront are both on localhost
# (ports do not scope cookies), and a value the browser cannot match
# would make login silently fail.
#
# In production set it to the registrable domain with a leading dot —
# ".raviscort.com" — so the Next.js server on raviscort.com can read
# cookies issued by api.raviscort.com. Its /admin route middleware needs
# them; without this every admin is redirected to login.
# COOKIE_DOMAIN=.raviscort.com

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ecommerce?schema=public"
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ecommerce_shadow?schema=public"

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=

# ── Seeded super admin (prisma/seed.ts) ──────────────────────────────
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-me

# ── Email ────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_FROM=no-reply@example.com
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=replace-me

# ── Cloudinary ───────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# ── Razorpay ─────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-me
