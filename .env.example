# Copy to .env and fill in real values. Never commit .env.

# ── Server ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# Number of proxy hops to trust, or "true"/"false".
# Set this when running behind a load balancer or reverse proxy,
# otherwise rate limiting and req.ip see the proxy instead of the client.
TRUST_PROXY=false

# Comma-separated list of browser origins allowed to call this API with
# credentials. Exact matches only — no wildcards, no reflection.
#
# The storefront and the admin portal are separate apps on separate
# origins, so each needs its own entry here. Locally the storefront runs
# on 3000 and the admin portal on 3001.
#
# Production: https://raviscort.com,https://admin.raviscort.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Security does not depend on NODE_ENV: auth cookies are Secure and error
# bodies are generic unless you opt out below. Both escape hatches are for
# local development only and the server refuses to start with them in
# production. (Browsers treat http://localhost as secure, so most local
# setups need neither.)
# COOKIE_INSECURE_DEV=true
# EXPOSE_ERROR_DETAILS=true
#
# The server validates its configuration at start-up and exits listing
# every problem (missing/weak secrets, missing webhook secret or
# COOKIE_DOMAIN in production, …).

# Milliseconds the process waits for in-flight work before forcing exit.
SHUTDOWN_TIMEOUT_MS=15000

# Minutes east of UTC used to turn a "YYYY-MM-DD" filter into a whole
# local day. 330 = IST.
APP_UTC_OFFSET_MINUTES=330

# ── Auth ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
# They MUST differ from each other.
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me

# Pinned into every token and required at verification.
JWT_ISSUER=e-commerce-api
JWT_AUDIENCE=e-commerce-client

# Domain scope for the auth cookies.
#
# The storefront and the admin portal hold separate sessions, each with
# its own cookie pair, so signing into one does not sign you into the
# other:
#   storefront   access_token        refresh_token
#   admin portal admin_access_token  admin_refresh_token
#
# Leave UNSET locally: the API, the storefront and the admin portal are
# all on localhost (ports do not scope cookies), and a value the browser
# cannot match would make login silently fail.
#
# In production set it to the registrable domain with a leading dot —
# ".raviscort.com" — so the Next.js servers on raviscort.com and
# admin.raviscort.com can both read cookies issued by api.raviscort.com.
# Their route middleware needs them; without this every admin is
# redirected to login and the admin portal is unusable.
# COOKIE_DOMAIN=.raviscort.com

# ── Admin sign-in hardening ──────────────────────────────────────────
# TOTP second factor for admin accounts. The key encrypts stored TOTP
# secrets; generate with: openssl rand -hex 32  (64 hex characters).
# Without it, admins cannot enrol in two-factor authentication.
MFA_ENCRYPTION_KEY=

# When true, an admin without two-factor can only reach the enrolment
# endpoints (/api/v1/auth/admin/mfa/*) until they enrol. Turn it on only
# once the admin portal has an MFA enrolment screen — otherwise admins
# without MFA cannot use the portal at all.
ADMIN_MFA_REQUIRED=false

# Label shown in authenticator apps.
# MFA_ISSUER=Raviscort Admin

# Reject passwords found in Have I Been Pwned (k-anonymity: only the first
# 5 characters of the SHA-1 hash are sent). Fails open if HIBP is down.
PASSWORD_BREACH_CHECK=false

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ecommerce?schema=public"
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ecommerce_shadow?schema=public"

# Connection pool. Each checkout holds one connection for the length of a
# Serializable transaction, so size this above your expected concurrency.
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000

# ── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=

# ── Seeded super admin (prisma/seed.ts) ──────────────────────────────
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-me

# ── Email (Resend) ───────────────────────────────────────────────────
# Resend is the only mail transport. All three required values below are
# read at startup, so the process refuses to boot without them rather
# than dropping every verification email in silence.
#
# Create the key at https://resend.com/api-keys with sending access.
RESEND_API_KEY=re_replace_me

# Must use a domain verified in Resend, otherwise every send is rejected.
# The display name lives here too, so it is configuration rather than a
# string literal in the mailer.
RESEND_FROM="Raviscort <no-reply@raviscort.com>"

# Optional. Where customer replies land. Omit to use the template default.
# RESEND_REPLY_TO=support@raviscort.com

# Published template aliases from the Resend dashboard. Subject, markup
# and preview text all live there — the code only supplies variables and
# never contains HTML. Variable names are ASCII letters, digits and
# underscores; FIRST_NAME, LAST_NAME, EMAIL and UNSUBSCRIBE_URL are
# reserved by Resend and cannot be used.
#
#   otp-verification   variables: OTP_CODE, EXPIRY_MINUTES
RESEND_TEMPLATE_OTP=otp-verification

#   password-reset     variables: RESET_URL, EXPIRY_MINUTES
# Optional; without it "forgot password" still answers normally but no
# email is sent (and an alert is logged).
RESEND_TEMPLATE_PASSWORD_RESET=password-reset

# Pages that receive ?token=… from the reset email: customers go to the
# storefront, admins to the admin portal (whose proxy only treats /auth/*
# as public). Production: https://raviscort.com/reset-password and
# https://admin.raviscort.com/auth/reset-password
PASSWORD_RESET_URL=http://localhost:3000/reset-password
ADMIN_PASSWORD_RESET_URL=http://localhost:3001/auth/reset-password

# Absolute session lifetimes (a session is never extended past these,
# however often it is refreshed).
SESSION_MAX_AGE_CUSTOMER_DAYS=30
SESSION_MAX_AGE_ADMIN_HOURS=12

# ── Cloudinary ───────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# ── Razorpay ─────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-me

# Set in the Razorpay dashboard when creating the webhook pointing at
# POST /api/v1/webhooks/razorpay. Without it the webhook rejects
# everything, and payment state depends on the browser calling back.
RAZORPAY_WEBHOOK_SECRET=replace-me
