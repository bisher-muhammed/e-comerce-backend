generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  firstName String
  lastName  String?
  role      UserRole   @default(CUSTOMER)
  status    UserStatus @default(PENDING_VERIFICATION)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  credential UserCredential?
  cart       Cart?
}

model UserCredential {
  userId       Int    @id
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id Int @id @default(autoincrement())

  name        String  @unique
  slug        String  @unique
  description String?
  details     String?

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  isActive Boolean @default(true)

  colors ProductColor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
}

model Color {
  id Int @id @default(autoincrement())

  name    String  @unique
  slug    String  @unique
  hexCode String?

  products ProductColor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Size {
  id Int @id @default(autoincrement())

  name      String @unique
  sortOrder Int    @unique

  variants ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductColor {
  id Int @id @default(autoincrement())

  productId Int
  colorId   Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color   Color   @relation(fields: [colorId], references: [id], onDelete: Restrict)

  images   ProductImage[]
  variants ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, colorId])
  @@index([productId])
  @@index([colorId])
}

model ProductVariant {
  id Int @id @default(autoincrement())

  productColorId Int
  sizeId         Int

  productColor ProductColor @relation(fields: [productColorId], references: [id], onDelete: Cascade)
  size         Size         @relation(fields: [sizeId], references: [id], onDelete: Restrict)

  price Decimal @db.Decimal(10, 2)
  stock Int     @default(0)

  cartItems CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productColorId, sizeId])
  @@index([productColorId])
  @@index([sizeId])
}

model ProductImage {
  id Int @id @default(autoincrement())

  productColorId Int

  /**
   * Cloudinary information.
   * url      -> URL used by the frontend
   * publicId -> used internally by the backend
   */
  publicId String
  url      String

  altText String?

  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  productColor ProductColor @relation(fields: [productColorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productColorId])
}

model Cart {
  id Int @id @default(autoincrement())

  userId Int @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id Int @id @default(autoincrement())

  cartId Int

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productVariantId Int

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productVariantId])
  @@index([cartId])
  @@index([productVariantId])
}
