generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  firstName String
  lastName  String?
  role      UserRole   @default(CUSTOMER)
  status    UserStatus @default(PENDING_VERIFICATION)

  // Admin permissions (M9); SUPER_ADMIN implicitly holds all of them.
  permissions String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  credential   UserCredential?
  cart         Cart?
  wishlist     Wishlist?
  addresses    Address[]
  orders       Order[]
  couponClaims CouponClaim[]
  auditLogs    AuditLog[]

  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin)
}

model UserCredential {
  userId       Int    @id
  passwordHash String

  // TOTP second factor (M4). The secret is AES-256-GCM encrypted with
  // MFA_ENCRYPTION_KEY; it is never stored or returned in clear.
  totpSecret    String?
  totpEnabledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)

  products Product[]
  offers   Offer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id Int @id @default(autoincrement())

  name        String  @unique
  slug        String  @unique
  description String?
  details     String?

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  isActive Boolean @default(true)

  colors        ProductColor[]
  wishlistItems WishlistItem[]

  offers Offer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive, createdAt])
  @@index([createdAt])
}

model Color {
  id Int @id @default(autoincrement())

  name    String  @unique
  slug    String  @unique
  hexCode String?

  products ProductColor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Size {
  id Int @id @default(autoincrement())

  name      String @unique
  sortOrder Int    @unique

  variants ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductColor {
  id Int @id @default(autoincrement())

productId Int
colorId Int
isActive Boolean @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color   Color   @relation(fields: [colorId], references: [id], onDelete: Restrict)

  images   ProductImage[]
  variants ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, colorId])
  @@index([productId])
  @@index([colorId])
}

model ProductVariant {
  id Int @id @default(autoincrement())

productColorId Int
sizeId Int
isActive Boolean @default(true)


  productColor ProductColor @relation(fields: [productColorId], references: [id], onDelete: Cascade)
  size         Size         @relation(fields: [sizeId], references: [id], onDelete: Restrict)

  price Decimal @db.Decimal(10, 2)
  stock Int     @default(0)


cartItems CartItem[]
orderItems OrderItem[]
stockMovements StockMovement[]


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productColorId, sizeId])
  @@index([productColorId])
  @@index([sizeId])
}

model ProductImage {
  id Int @id @default(autoincrement())

  productColorId Int
  publicId       String
  url            String

  altText String?

  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  productColor ProductColor @relation(fields: [productColorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productColorId])
}

model Cart {
  id Int @id @default(autoincrement())

  userId Int @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id Int @id @default(autoincrement())

  cartId Int

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productVariantId Int

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  quantity Int @default(1)

  priceSnapshot Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productVariantId])
  @@index([cartId])
  @@index([productVariantId])
}

model Wishlist {
  id Int @id @default(autoincrement())

  userId Int @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  items WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WishlistItem {
  id Int @id @default(autoincrement())

  wishlistId Int
  productId  Int

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@index([productId])
}

model Address {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  label AddressLabel @default(HOME)

  firstName String
  lastName  String?
  phone     String

  addressLine1 String
  addressLine2 String
  landmark     String?

  city       String
  state      String
  postalCode String
  country    String @default("India")

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Order {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)

  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)

  razorpayOrderId    String? @unique
  razorpayPaymentId  String? @unique
  razorpaySignature  String?
  cancellationReason String?

  contactEmail String
  contactPhone String

  shippingFirstName  String
  shippingLastName   String?
  shippingPhone      String
  shippingLine1      String
  shippingLine2      String
  shippingLandmark   String?
  shippingCity       String
  shippingState      String
  shippingPostalCode String
  shippingCountry    String

  subtotal Decimal @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  cancelledAmount Decimal @default(0) @db.Decimal(10, 2)
  // Net value (after coupon allocation) of units returned and received.
  returnedAmount  Decimal @default(0) @db.Decimal(10, 2)
  refundedAmount  Decimal @default(0) @db.Decimal(10, 2)

  couponCode     String?
  couponDiscount Decimal? @db.Decimal(10, 2)

  idempotencyKey String

  expiresAt DateTime?

  // Start of the return window.
  deliveredAt DateTime?

  items       OrderItem[]
  couponClaim CouponClaim?
  refunds     Refund[]
  returns     ReturnRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, paymentStatus, expiresAt])
  @@index([contactEmail(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([contactPhone(ops: raw("gin_trgm_ops"))], type: Gin)
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

model Refund {
  id                Int          @id @default(autoincrement())
  orderId           Int
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  amount            Decimal      @db.Decimal(10, 2)
  status            RefundStatus @default(PENDING)
  razorpayPaymentId String
  razorpayRefundId  String?      @unique
  reason            String?
  failureReason     String?
  idempotencyKey    String

  // True when the refunded payment is not the order's own payment — a
  // capture that arrived after the order stopped accepting payment, or a
  // duplicate payment. Those are owed in full and are not tracked in
  // Order.refundedAmount.
  orphanPayment Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, idempotencyKey])
  @@index([orderId])
  @@index([status, updatedAt])
  @@index([razorpayPaymentId])
}

model OrderItem {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productVariantId Int
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  productName String
  colorName   String
  sizeName    String
  price       Decimal @db.Decimal(10, 2)

  quantity          Int
  remainingQuantity Int
  cancelledQuantity Int @default(0)
  returnedQuantity  Int @default(0)

  actions OrderItemAction[]
  returns ReturnRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productVariantId])
  @@index([productName(ops: raw("gin_trgm_ops"))], type: Gin)
}

model OrderItemAction {
  id Int @id @default(autoincrement())

  orderItemId Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  type     OrderItemActionType
  quantity Int
  reason   String?

  idempotencyKey String

  createdAt DateTime @default(now())

  @@unique([orderItemId, idempotencyKey])
  @@index([orderItemId])
}

/// One row per successful admin mutation (and customer-data view) — M9.
model AuditLog {
  id Int @id @default(autoincrement())

  actorId    Int?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String
  actorRole  UserRole

  /// "<METHOD> <route template>", e.g. "PATCH /api/v1/admin/orders/:orderId/status"
  action     String
  entityType String?
  entityId   String?
  statusCode Int

  /// Params, query and body with secrets redacted.
  requestData Json?

  ip        String?
  userAgent String?
  requestId String?

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

/// One customer return of some units of an order item (audit H4).
/// Units under an open request are neither remaining nor returned:
/// quantity = remaining + cancelled + returned + Σ open request quantity.
model ReturnRequest {
  id Int @id @default(autoincrement())

  orderId     Int
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  quantity Int
  reason   String
  status   ReturnStatus @default(REQUESTED)

  idempotencyKey String

  adminNote String?

  /// Net amount credited to the order when the goods were received.
  refundAmount          Decimal? @db.Decimal(10, 2)
  /// Reference for money returned outside Razorpay (COD orders).
  manualRefundReference String?

  decidedAt  DateTime?
  receivedAt DateTime?
  refundedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderItemId, idempotencyKey])
  @@index([orderId])
  @@index([status, createdAt])
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id Int @id @default(autoincrement())

  code String @unique
  name String

  discountType          CouponDiscountType
  discountValue         Decimal            @db.Decimal(10, 2)
  minimumOrderAmount    Decimal            @default(0) @db.Decimal(10, 2)
  maximumDiscountAmount Decimal?           @db.Decimal(10, 2)

  startsOn  DateTime @db.Date
  expiresOn DateTime @db.Date

  isActive   Boolean @default(true)
  usageLimit Int?
  usedCount  Int     @default(0)

  claims CouponClaim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([startsOn, expiresOn])
}

model CouponClaim {
  id Int @id @default(autoincrement())

  couponId Int
  userId   Int

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  claimedAt DateTime  @default(now())
  usedAt    DateTime?

  orderId Int?   @unique
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([couponId, userId])
  @@index([userId])
  @@index([couponId])
}

model Offer {
  id Int @id @default(autoincrement())

  type OfferType

  productId  Int?
  categoryId Int?

  product  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  discountPercentage Decimal @db.Decimal(5, 2)

  startsOn  DateTime
  expiresOn DateTime
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([categoryId])
  @@index([isActive, startsOn, expiresOn])
}


model StockMovement {
  id Int @id @default(autoincrement())

  productVariantId Int
  // Restrict: the ledger is append-only history; a variant with movements
  // is deactivated rather than deleted (M11).
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  type          StockMovementType
  change        Int
  previousStock Int
  newStock      Int

  orderItemId Int?
  reason      String?

  // Admin restock/adjust replays with the same key return the original row.
  idempotencyKey String?

  // Only add these if/when you actually need them:
  supplierName String?
  unitCost     Decimal? @db.Decimal(10, 2)
  batchNumber  String?

  createdAt DateTime @default(now())

  @@unique([productVariantId, idempotencyKey])
  @@index([productVariantId, createdAt])
  @@index([type])
  @@index([orderItemId])
}

enum AddressLabel {
  HOME
  OFFICE
  OTHER
}

enum PaymentMethod {
  COD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  CANCELLED
  DELIVERED
}

enum OrderItemActionType {
  CANCEL
  RETURN
}

enum OfferType {
  PRODUCT
  CATEGORY
}


enum StockMovementType {
  INITIAL_STOCK
  ORDER_PLACED
  ORDER_CANCELLED
  ORDER_RETURNED
  MANUAL_ADJUSTMENT
  RESTOCK
}